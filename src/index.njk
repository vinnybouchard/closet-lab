---
layout: base.njk
---
{%- set posts = collections.posts %}
{%- set latest = posts | first %}
<main>

  <section class="hero index{% if not site.heroImage %} nophoto{% endif %}">
    {%- if site.heroImage %}
    <div class="art lighten"><img src="{{ site.heroImage }}" alt=""></div>
    {%- endif %}
    <div class="scrim"></div>
    <div aria-hidden="true" class="ghost closet">closet</div>
    <div class="rail">
      <span class="t">{{ site.rails.left }}</span>
      <span class="line"></span>
      <span class="t">{{ site.rails.right }}</span>
    </div>
    <div class="plate">
      <h1>{{ site.title }}</h1>
      <p class="lede">{{ site.tagline }}</p>
    </div>
  </section>

  {%- set topics = posts | topicCounts %}
  {%- if topics | length %}
  <nav class="strip bottom-strip">
    <a href="/" aria-current="page">All <span class="n">{{ posts | length }}</span></a>
    {%- for t in topics %}
    <a href="/tags/{{ t.slug }}/">{{ t.name }} <span class="n">{{ t.count }}</span></a>
    {%- endfor %}
  </nav>
  {%- endif %}

  {%- if latest %}
  <section class="feature">
    <div class="lead{% if not latest.data.cover %} nophoto{% endif %}">
      {%- if latest.data.cover %}
      <div class="art lighten"><img src="{{ latest.data.cover }}" alt=""></div>
      {%- endif %}
      <div class="scrim"></div>
      <div class="plate">
        <span class="kicker">Latest</span>
        <h2>{{ latest.data.title }}</h2>
      </div>
    </div>
    <div class="panels">
      <div class="panel summary">
        <span class="when">{{ latest.date | readable }}{% if latest.data.topic %} · {{ latest.data.topic }}{% endif %}</span>
        <p>{{ latest.data.summary }}</p>
        <a class="go" href="{{ latest.url }}">Read the post →</a>
      </div>
      {%- if site.stats %}
      <div class="panel stats">
        {%- for s in site.stats %}
        <div class="stat">
          <span class="n">{{ s.n }}</span>
          <span class="label">{{ s.label }}</span>
        </div>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if site.nowList %}
      <div class="panel now">
        <span class="head">Right now</span>
        <ul class="nowlist">
          {%- for item in site.nowList %}
          <li><span class="dash">—</span>{{ item }}</li>
          {%- endfor %}
        </ul>
      </div>
      {%- endif %}
    </div>
  </section>
  {%- endif %}

  <section class="band">
    <div aria-hidden="true" class="ghost posts">posts</div>
    <div class="sec-head"><h2>Posts</h2><span class="sub">newest first</span></div>

    {%- set feature = posts | slice_(0, 4) %}
    {%- set older = posts | slice_(4) %}
    {%- if feature | length %}
    <div class="cards">
      {%- for post in feature %}
      <a class="pcard" href="{{ post.url }}">
        {%- if post.data.cover %}<div class="art lighten"><img src="{{ post.data.cover }}" alt=""></div>{% endif %}
        <div class="scrim"></div>
        {%- if post.data.topic %}<span class="topic">{{ post.data.topic }}</span>{% endif %}
        <div class="foot">
          <span class="date">{{ post.date | readable }}</span>
          <span class="title">{{ post.data.title }}</span>
        </div>
      </a>
      {%- endfor %}
    </div>
    {%- else %}
    <p class="empty">No posts yet.</p>
    {%- endif %}

    {%- if older | length %}
    <div class="rows">
      {%- for post in older %}
      <a href="{{ post.url }}">
        <span class="date">{{ post.date | readable }}</span>
        <span class="title">{{ post.data.title }}</span>
        <span class="topic">{{ post.data.topic }}</span>
      </a>
      {%- endfor %}
      <div class="rule"></div>
    </div>
    {%- endif %}
  </section>
</main>
