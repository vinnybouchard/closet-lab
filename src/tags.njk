---
pagination:
  data: collections.topics
  size: 1
  alias: topic
permalink: "/tags/{{ topic.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ topic.name }}"
---
<main>
  <section class="tag-head">
    <span class="kicker">Topic</span>
    <h1>{{ topic.name }}</h1>
    <p class="count">{{ topic.posts | length }} post{% if (topic.posts | length) != 1 %}s{% endif %}</p>
  </section>
  <div class="rule"></div>
  <div class="rows">
    {%- for post in topic.posts %}
    <a href="{{ post.url }}">
      <span class="date">{{ post.date | readable }}</span>
      <span class="title">{{ post.data.title }}</span>
      <span class="topic">{{ post.data.topic }}</span>
    </a>
    {%- endfor %}
    <div class="rule"></div>
  </div>
  <p class="more"><a href="/">← All posts</a></p>
</main>
