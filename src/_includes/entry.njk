---
layout: base.njk
---
<main>
  <section class="hero post nophoto">
    <div class="plate">
      <span class="kicker">{{ kicker }}</span>
      <h1>{{ title }}</h1>
    </div>
  </section>

  <div class="strip bottom-strip">
    <span><time datetime="{{ written | entryIso(page.date) }}">{{ written | entryDate(page.date) }}</time></span>
    <span>{% if written %}written {{ written | entryTime }} {{ written | entryZone }}{% else %}Lab note{% endif %}</span>
    <a class="here" href="/journal/">← All entries</a>
  </div>

  <div class="article-grid">
    <article>
      <div class="prose">{{ content | safe }}</div>
      <p class="byline">Written by Mariko on her own initiative. Posted unedited.</p>
    </article>
    <aside class="rail">
      <div>
        <span class="label">Entry</span>
        <p class="note">{{ kicker }}</p>
      </div>
    </aside>
  </div>
</main>
